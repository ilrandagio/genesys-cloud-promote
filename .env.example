# In locale è più semplice generarlo con:
#   npm run setup -- --region mypurecloud.de --client-id <id> --client-secret <secret>
# Per Docker: copiare in .env e compilare (APP_URL=http://localhost:8080).

# Almeno 32 caratteri casuali:  openssl rand -hex 32
JWT_SECRET=

# Chiave AES-256 per cifrare i client secret degli ambienti:  openssl rand -base64 32
# ATTENZIONE: se la perdi, i secret salvati non sono più decifrabili.
ENCRYPTION_KEY=

# URL dell'interfaccia. Redirect URI da registrare nel client OAuth: APP_URL/api/auth/callback
APP_URL=http://localhost:5173

# ---- Login con Genesys Cloud (OAuth "Code Authorization") ----
GENESYS_LOGIN_REGION=mypurecloud.de
GENESYS_LOGIN_CLIENT_ID=
GENESYS_LOGIN_CLIENT_SECRET=
# Facoltativi: limitare l'accesso a un ruolo Genesys e/o a un elenco di email (separate da virgola)
GENESYS_LOGIN_REQUIRED_ROLE=
APP_ALLOWED_EMAILS=

# ---- Autorizzazioni sul rilascio ----
# Chi può ESEGUIRE i plan (ruolo Genesys e/o email separate da virgola). Entrambi vuoti = tutti gli utenti
GENESYS_APPLY_ROLE=
APP_APPLY_EMAILS=
# Chi può APPROVARE i plan verso ambienti protetti. Entrambi vuoti = tutti, tranne chi ha creato il plan
GENESYS_APPROVER_ROLE=
APP_APPROVER_EMAILS=
# Validità di un plan in ore
PLAN_TTL_HOURS=24

# PostgreSQL consigliato per dati che devono durare. Vuoti = database integrato (PGlite) + coda interna
# Lasciare vuoti per la modalità locale (database integrato + coda interna)
DATABASE_URL=
REDIS_URL=

# Versione del provider Terraform genesyscloud usata da export e apply
GENESYS_PROVIDER_VERSION=>= 1.50.0
