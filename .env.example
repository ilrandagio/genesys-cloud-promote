# Copiare in .env e compilare.

# Almeno 32 caratteri casuali:  openssl rand -hex 32
JWT_SECRET=

# Chiave AES-256 per cifrare i client secret degli ambienti:  openssl rand -base64 32
# ATTENZIONE: se la perdi, i secret salvati non sono più decifrabili.
ENCRYPTION_KEY=

# Utenti dell'app: utente:hashBcrypt separati da virgola.
# Hash:  npm run hash-password -w apps/api -- "laPassword"
# (racchiudere tra apici singoli: gli hash bcrypt contengono "$")
APP_USERS='admin:$2a$10$...'

# Solo per sviluppo senza docker
DATABASE_URL=postgres://gcp:gcp@localhost:5432/gcp
REDIS_URL=redis://localhost:6379

# Versione del provider Terraform genesyscloud usata da export e apply
GENESYS_PROVIDER_VERSION=>= 1.50.0
