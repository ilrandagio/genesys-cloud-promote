{
  "name": "@genesys-cloud-promote/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "hash-password": "node -e \"console.log(require('bcryptjs').hashSync(process.argv[1], 10))\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.2.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
